# Copy this file to .env.local (gitignored) and fill in real values.
# In production (Vercel), set these under Project Settings → Environment Variables.

# Resend (https://resend.com) — powers /api/send-email, used by the quote
# request, contact, and imported-gifts enquiry forms.
# 1. Create a free Resend account.
# 2. Verify the kingsport.co.zw domain (or a subdomain like mail.kingsport.co.zw)
#    under Domains — this adds a couple of DNS records and is required before
#    RESEND_FROM_EMAIL below can send. Resend's dashboard walks you through it.
# 3. Create an API key under API Keys and paste it here.
RESEND_API_KEY=

# Must be on the domain you verified in step 2 above.
RESEND_FROM_EMAIL="Kingsport Website <website@kingsport.co.zw>"

# Where quote/contact/enquiry form submissions land.
SALES_EMAIL=sales@kingsport.co.zw
